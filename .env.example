# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=dressa
POSTGRES_PASSWORD=dressa
POSTGRES_DB=dressa
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dressa:dressa@localhost:5432/dressa?schema=public

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=wardrobe_items

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Services ---
API_GATEWAY_PORT=3000
ML_ENGINE_PORT=8000
ML_ENGINE_URL=http://localhost:8000

# --- External APIs ---
OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
